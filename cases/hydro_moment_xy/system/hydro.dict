Hydrodynamics
{
    coordinateSystem planar2D;
    timeScheme cchMomentMidpoint;
    materialModel constant;
    density 1.3;
    viscosity 0.02;
    initialVelocity vortex;
    velocityAmplitude 1;
    linearResidualTolerance 1e-11;
    Moment
    {
        maximumIterations 24;
        convection central;
    }
}
