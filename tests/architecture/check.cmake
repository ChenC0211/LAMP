# Inspect the actual production targets, including evaluated transitive usage
# requirements. This check uses only CMake and the project's C++17 compiler.
get_property(_architecture_targets DIRECTORY "${PROJECT_SOURCE_DIR}" PROPERTY BUILDSYSTEM_TARGETS)
set(_architecture_graph "")
foreach(_target IN LISTS _architecture_targets)
    get_target_property(_type ${_target} TYPE)
    if(_type STREQUAL "UTILITY")
        continue()
    endif()
    string(APPEND _architecture_graph "target|${_target}\n")
    get_target_property(_sources ${_target} SOURCES)
    if(_sources)
        foreach(_source IN LISTS _sources)
            if(_source MATCHES "^\\$<TARGET_OBJECTS:([^>]+)>$")
                string(APPEND _architecture_graph "link|${_target}|${CMAKE_MATCH_1}\n")
            elseif(_source MATCHES "\\$<")
                message(FATAL_ERROR "Architecture check needs an explicit source owner: ${_target}: ${_source}")
            else()
                get_filename_component(_source "${_source}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
                string(APPEND _architecture_graph "source|${_target}|${_source}\n")
            endif()
        endforeach()
    endif()
    foreach(_property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES INCLUDE_DIRECTORIES INTERFACE_INCLUDE_DIRECTORIES)
        if(_property MATCHES "LINK_LIBRARIES$")
            set(_kind link)
        else()
            set(_kind include)
        endif()
        set(_values "$<TARGET_GENEX_EVAL:${_target},$<TARGET_PROPERTY:${_target},${_property}>>")
        string(APPEND _architecture_graph "${_kind}|${_target}|$<JOIN:${_values},\n${_kind}|${_target}|>\n")
    endforeach()
endforeach()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/architecture-$<CONFIG>.txt" CONTENT "${_architecture_graph}")
add_executable(lamp_architecture_check "${CMAKE_CURRENT_LIST_DIR}/check.cpp")
add_test(NAME architecture COMMAND lamp_architecture_check "${PROJECT_SOURCE_DIR}"
    "${CMAKE_CURRENT_BINARY_DIR}/architecture-$<CONFIG>.txt")
add_test(NAME architecture_self_test COMMAND lamp_architecture_check --self-test
    "${PROJECT_SOURCE_DIR}/runs/checks/architecture_self_test/fixtures")
unset(_architecture_graph)
unset(_architecture_targets)
