if(NOT DEFINED PROJECT_ROOT)
    message(FATAL_ERROR "PROJECT_ROOT is required")
endif()
file(GLOB_RECURSE _route_files LIST_DIRECTORIES FALSE
    "${PROJECT_ROOT}/src/*" "${PROJECT_ROOT}/include/*"
    "${PROJECT_ROOT}/tests/*" "${PROJECT_ROOT}/cases/*" "${PROJECT_ROOT}/tools/*")
foreach(_entry IN LISTS _route_files)
    get_filename_component(_name "${_entry}" NAME)
    string(TOLOWER "${_name}" _lower_name)
    if(_lower_name MATCHES "sevof")
        file(RELATIVE_PATH _relative "${PROJECT_ROOT}" "${_entry}")
        message(FATAL_ERROR "Retired SEVOF file must remain removed: ${_relative}")
    endif()
endforeach()
unset(_route_files)
file(GLOB_RECURSE _misplaced_headers
    "${PROJECT_ROOT}/src/*.h" "${PROJECT_ROOT}/src/*.hpp"
    "${PROJECT_ROOT}/src/*.hxx" "${PROJECT_ROOT}/src/*.inl" "${PROJECT_ROOT}/src/*.tpp")
file(GLOB_RECURSE _misplaced_units
    "${PROJECT_ROOT}/include/*.c" "${PROJECT_ROOT}/include/*.cc"
    "${PROJECT_ROOT}/include/*.cpp" "${PROJECT_ROOT}/include/*.cxx")
if(_misplaced_headers OR _misplaced_units)
    message(FATAL_ERROR "Headers belong in include/ and translation units in src/: ${_misplaced_headers};${_misplaced_units}")
endif()
file(GLOB_RECURSE _case_entries LIST_DIRECTORIES TRUE "${PROJECT_ROOT}/cases/*")
foreach(_entry IN LISTS _case_entries)
    file(RELATIVE_PATH _relative "${PROJECT_ROOT}/cases" "${_entry}")
    if(_relative MATCHES "(^|/)(output|runtime|build)(/|$)" OR _relative MATCHES "\\.(log|exe|dll)$")
        message(FATAL_ERROR "Generated case artifact must be in runs/: cases/${_relative}")
    endif()
endforeach()
file(GLOB _doc_root LIST_DIRECTORIES FALSE "${PROJECT_ROOT}/docs/*")
foreach(_entry IN LISTS _doc_root)
    get_filename_component(_name "${_entry}" NAME)
    if(NOT _name STREQUAL "README.md" AND NOT _name MATCHES "^0[0-7]_LAMP_[A-Za-z_]+\\.md$"
        AND NOT _name STREQUAL "08_LAMP_Module_Boundaries.md"
        AND NOT _name STREQUAL "09_LAMP_Time_Advance_Rules.md")
        message(FATAL_ERROR "docs root is reserved for current constraints/index: ${_name}")
    endif()
endforeach()
file(GLOB _tools_root LIST_DIRECTORIES FALSE "${PROJECT_ROOT}/tools/*")
foreach(_entry IN LISTS _tools_root)
    get_filename_component(_name "${_entry}" NAME)
    if(NOT _name MATCHES "^(build|run_case)\\.(cmd|ps1)$" AND NOT _name STREQUAL "README.md")
        message(FATAL_ERROR "Give the tool a documented subdirectory/owner: tools/${_name}")
    endif()
endforeach()
file(GLOB _test_root LIST_DIRECTORIES FALSE "${PROJECT_ROOT}/tests/*")
foreach(_entry IN LISTS _test_root)
    get_filename_component(_name "${_entry}" NAME)
    if(NOT _name STREQUAL "README.md" AND NOT _name STREQUAL "CMakeLists.txt" AND NOT _name STREQUAL "repository_layout.cmake")
        message(FATAL_ERROR "Test sources/scripts belong in contracts, support, or fixtures: tests/${_name}")
    endif()
endforeach()
file(GLOB_RECURSE _case_sources "${PROJECT_ROOT}/cases/*.cpp" "${PROJECT_ROOT}/cases/*.h")
foreach(_entry IN LISTS _case_sources)
    file(RELATIVE_PATH _relative "${PROJECT_ROOT}/cases" "${_entry}")
    if(NOT _relative MATCHES "^benchmarks/")
        message(FATAL_ERROR "Case code is only allowed for explicit benchmark drivers: ${_relative}")
    endif()
endforeach()
# Four registered production Apps. The two retained old App directories
# are reference assets; their source lists and dispatcher must stay disabled.
set(_lamp_apps Electric Hydrodynamics Pic VofElectrohydrodynamics)
set(_lamp_reference_apps Electrohydrodynamics Interface)
set(_lamp_shared_io CaseDocuments DictionaryParallel DictionaryRun DictionaryRunControls TwoPhaseInputComponents HydroOutputComponents)
foreach(_root src/Apps include/Apps)
    file(GLOB _app_entries LIST_DIRECTORIES TRUE RELATIVE "${PROJECT_ROOT}/${_root}" "${PROJECT_ROOT}/${_root}/*")
    foreach(_entry IN LISTS _app_entries)
        list(FIND _lamp_apps "${_entry}" _known)
        if(IS_DIRECTORY "${PROJECT_ROOT}/${_root}/${_entry}")
            list(FIND _lamp_reference_apps "${_entry}" _reference)
            if(_known EQUAL -1 AND _reference EQUAL -1 AND NOT _entry STREQUAL "IO")
                message(FATAL_ERROR "${_root}/${_entry} is not a registered App or shared IO; verification/benchmark code belongs to tests or cases/benchmarks")
            endif()
        else()
            if(_root STREQUAL "include/Apps")
                set(_root_files AppRegistry.h IApp.h RunCase.h RunConfig.h RunControls.h)
            else()
                set(_root_files AppRegistry.cpp RunCase.cpp lamp_main.cpp README.md)
            endif()
            list(FIND _root_files "${_entry}" _known_file)
            if(_known_file EQUAL -1)
                message(FATAL_ERROR "Unclassified shared App entry facility: ${_root}/${_entry}")
            endif()
        endif()
    endforeach()
    file(GLOB _io_entries LIST_DIRECTORIES TRUE "${PROJECT_ROOT}/${_root}/IO/*")
    foreach(_entry IN LISTS _io_entries)
        get_filename_component(_name "${_entry}" NAME_WE)
        list(FIND _lamp_shared_io "${_name}" _known_io)
        if(IS_DIRECTORY "${_entry}" OR _known_io EQUAL -1)
            message(FATAL_ERROR "Shared App IO must have a named, frozen responsibility: ${_entry}")
        endif()
    endforeach()
endforeach()
# The dispatcher itself must register exactly the same four production names.
file(READ "${PROJECT_ROOT}/src/Apps/RunCase.cpp" _dispatcher)
string(REGEX MATCHALL "registerApp\\([ \t]*\"[^\"]+\"" _registrations "${_dispatcher}")
list(LENGTH _registrations _registration_count)
if(NOT _registration_count EQUAL 4)
    message(FATAL_ERROR "Dispatcher must register exactly four production Apps")
endif()
foreach(_app IN LISTS _lamp_reference_apps)
    string(FIND "${_dispatcher}" "registerApp(\"${_app}\"" _registration)
    if(NOT _registration EQUAL -1)
        message(FATAL_ERROR "Reference App must not be registered: ${_app}")
    endif()
endforeach()
foreach(_app IN LISTS _lamp_apps)
    string(FIND "${_dispatcher}" "registerApp(\"${_app}\"" _registration)
    if(_registration EQUAL -1)
        message(FATAL_ERROR "Dispatcher lacks registered standard App: ${_app}")
    endif()
endforeach()
foreach(_app IN LISTS _lamp_apps)
    # The exact new VOF entry lives beside the retained HG reference files;
    # this maps its registered name without authorizing that old App.
    set(_app_dir "${_app}")
    if(_app STREQUAL "VofElectrohydrodynamics")
        set(_app_dir Electrohydrodynamics)
    endif()
    if(NOT EXISTS "${PROJECT_ROOT}/include/Apps/${_app_dir}/${_app}App.h" OR
       NOT EXISTS "${PROJECT_ROOT}/src/Apps/${_app_dir}/${_app}App.cpp")
        message(FATAL_ERROR "Registered App lacks its own entry: ${_app}")
    endif()
endforeach()
unset(_app_dir)
# Pure Hydro and shared fluid components may not absorb the joint EHD owner.
file(GLOB_RECURSE _pure_hydro "${PROJECT_ROOT}/include/Apps/Hydrodynamics/*.h" "${PROJECT_ROOT}/src/Apps/Hydrodynamics/*.cpp")
list(APPEND _pure_hydro
    "${PROJECT_ROOT}/include/Apps/IO/TwoPhaseInputComponents.h" "${PROJECT_ROOT}/src/Apps/IO/TwoPhaseInputComponents.cpp"
    "${PROJECT_ROOT}/include/Apps/IO/HydroOutputComponents.h" "${PROJECT_ROOT}/src/Apps/IO/HydroOutputComponents.cpp")
foreach(_entry IN LISTS _pure_hydro)
    file(READ "${_entry}" _source)
    if(_source MATCHES "[#][ \t]*include[ \t]*[\"<][^\">]*(Modules/Electric/|Electrohydrodynamics/|Apps/Coupling/)")
        message(FATAL_ERROR "Pure Hydro/IO has a joint electric dependency: ${_entry}")
    endif()
endforeach()
unset(_lamp_apps)
unset(_lamp_shared_io)
# Standalone Interface production is a generic transport App. Named problems
# and exact-solution drivers belong to tests/cases, even when they use the same
# numerical library. Keep the boundary checked as future tasks add code.
file(GLOB_RECURSE _interface_production
    "${PROJECT_ROOT}/src/Apps/Interface/*.cpp" "${PROJECT_ROOT}/include/Apps/Interface/*.h")
foreach(_entry IN LISTS _interface_production)
    file(READ "${_entry}" _source)
    if(_source MATCHES "InterfaceFirstJetBenchmark|PrescribedProblem|interfaceFirstJetProblemName|solidRotationXY|polynomialVortexXY|StaticCircleXY|enum[ \t\r\n]+class[ \t\r\n]+Problem")
        message(FATAL_ERROR "Named benchmark definition in Interface production; move it to cases/benchmarks: ${_entry}")
    endif()
endforeach()
file(GLOB_RECURSE _interface_dictionaries "${PROJECT_ROOT}/cases/*/interface.dict")
foreach(_entry IN LISTS _interface_dictionaries)
    get_filename_component(_system "${_entry}" DIRECTORY)
    if(EXISTS "${_system}/run.dict")
        file(READ "${_system}/run.dict" _run)
        if(_run MATCHES "app[ \t]+Interface[ \t]*;")
            file(READ "${_entry}" _input)
            if(_input MATCHES "Benchmark[ \t\r\n]*\\{|problem[ \t]+" OR
                _input MATCHES "[\n;{}][ \t\r\n]*(coordinates|Domain|Initial|Velocity|Constants|resolution|initialMesh|Refinement|Regrid|dt|endTime|steps|writeFields|writeEverySteps)[ \t{]")
                message(FATAL_ERROR "interface.dict owns only method/Boundary; use the G04 five-file schema: ${_entry}")
            endif()
            foreach(_required geometry mesh fields)
                if(NOT EXISTS "${_system}/${_required}.dict")
                    message(FATAL_ERROR "Missing ${_required}.dict in standalone Interface case: ${_system}")
                endif()
            endforeach()
        endif()
    endif()
endforeach()
message(STATUS "Repository layout OK: production, contracts, benchmarks, constraints and entry tools")
