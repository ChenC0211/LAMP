if(NOT DEFINED PROJECT_ROOT)
    message(FATAL_ERROR "PROJECT_ROOT is required")
endif()
file(GLOB_RECURSE _misplaced_headers
    "${PROJECT_ROOT}/src/*.h" "${PROJECT_ROOT}/src/*.hpp"
    "${PROJECT_ROOT}/src/*.hxx" "${PROJECT_ROOT}/src/*.inl" "${PROJECT_ROOT}/src/*.tpp")
file(GLOB_RECURSE _misplaced_units
    "${PROJECT_ROOT}/include/*.c" "${PROJECT_ROOT}/include/*.cc"
    "${PROJECT_ROOT}/include/*.cpp" "${PROJECT_ROOT}/include/*.cxx")
if(_misplaced_headers OR _misplaced_units)
    message(FATAL_ERROR "Headers belong in include/ and translation units in src/: ${_misplaced_headers};${_misplaced_units}")
endif()
file(GLOB_RECURSE _case_entries LIST_DIRECTORIES TRUE "${PROJECT_ROOT}/cases/*")
foreach(_entry IN LISTS _case_entries)
    file(RELATIVE_PATH _relative "${PROJECT_ROOT}/cases" "${_entry}")
    if(_relative MATCHES "(^|/)(output|runtime|build)(/|$)" OR _relative MATCHES "\\.(log|exe|dll)$")
        message(FATAL_ERROR "Generated case artifact must be in runs/: cases/${_relative}")
    endif()
endforeach()
file(GLOB _doc_root LIST_DIRECTORIES FALSE "${PROJECT_ROOT}/docs/*")
foreach(_entry IN LISTS _doc_root)
    get_filename_component(_name "${_entry}" NAME)
    if(NOT _name STREQUAL "README.md" AND NOT _name MATCHES "^0[0-7]_LAMP_[A-Za-z_]+\\.md$")
        message(FATAL_ERROR "docs root is reserved for current constraints/index: ${_name}")
    endif()
endforeach()
file(GLOB _tools_root LIST_DIRECTORIES FALSE "${PROJECT_ROOT}/tools/*")
foreach(_entry IN LISTS _tools_root)
    get_filename_component(_name "${_entry}" NAME)
    if(NOT _name MATCHES "^(build|run_case)\\.(cmd|ps1)$" AND NOT _name STREQUAL "README.md")
        message(FATAL_ERROR "Give the tool a documented subdirectory/owner: tools/${_name}")
    endif()
endforeach()
file(GLOB _test_root LIST_DIRECTORIES FALSE "${PROJECT_ROOT}/tests/*")
foreach(_entry IN LISTS _test_root)
    get_filename_component(_name "${_entry}" NAME)
    if(NOT _name STREQUAL "README.md" AND NOT _name STREQUAL "CMakeLists.txt" AND NOT _name STREQUAL "repository_layout.cmake")
        message(FATAL_ERROR "Test sources/scripts belong in contracts, support, or fixtures: tests/${_name}")
    endif()
endforeach()
file(GLOB_RECURSE _case_sources "${PROJECT_ROOT}/cases/*.cpp" "${PROJECT_ROOT}/cases/*.h")
foreach(_entry IN LISTS _case_sources)
    file(RELATIVE_PATH _relative "${PROJECT_ROOT}/cases" "${_entry}")
    if(NOT _relative MATCHES "^benchmarks/")
        message(FATAL_ERROR "Case code is only allowed for explicit benchmark drivers: ${_relative}")
    endif()
endforeach()
# Standalone Interface production is a generic transport App. Named problems
# and exact-solution drivers belong to tests/cases, even when they use the same
# numerical library. Keep the boundary checked as future tasks add code.
file(GLOB_RECURSE _interface_production
    "${PROJECT_ROOT}/src/Apps/Interface/*.cpp" "${PROJECT_ROOT}/include/Apps/Interface/*.h")
foreach(_entry IN LISTS _interface_production)
    file(READ "${_entry}" _source)
    if(_source MATCHES "InterfaceFirstJetBenchmark|PrescribedProblem|interfaceFirstJetProblemName|solidRotationXY|polynomialVortexXY|StaticCircleXY|enum[ \t\r\n]+class[ \t\r\n]+Problem")
        message(FATAL_ERROR "Named benchmark definition in Interface production; move it to cases/benchmarks: ${_entry}")
    endif()
endforeach()
file(GLOB_RECURSE _interface_dictionaries "${PROJECT_ROOT}/cases/*/interface.dict")
foreach(_entry IN LISTS _interface_dictionaries)
    get_filename_component(_system "${_entry}" DIRECTORY)
    if(EXISTS "${_system}/run.dict")
        file(READ "${_system}/run.dict" _run)
        if(_run MATCHES "app[ \t]+Interface[ \t]*;")
            file(READ "${_entry}" _input)
            if(_input MATCHES "Benchmark[ \t\r\n]*\\{|problem[ \t]+" OR
                _input MATCHES "[\n;{}][ \t\r\n]*(coordinates|Domain|Initial|Velocity|Constants|resolution|initialMesh|Refinement|Regrid|dt|endTime|steps|writeFields|writeEverySteps)[ \t{]")
                message(FATAL_ERROR "interface.dict owns only method/Boundary; use the G04 five-file schema: ${_entry}")
            endif()
            foreach(_required geometry mesh fields)
                if(NOT EXISTS "${_system}/${_required}.dict")
                    message(FATAL_ERROR "Missing ${_required}.dict in standalone Interface case: ${_system}")
                endif()
            endforeach()
        endif()
    endif()
endforeach()
message(STATUS "Repository layout OK: production, contracts, benchmarks, constraints and entry tools")
